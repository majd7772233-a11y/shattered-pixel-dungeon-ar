{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SPDMultiplayerProtocol",
  "version": "1.0.0",
  "type": "object",
  "required": [
    "protocolVersion",
    "messageType",
    "payloadJson"
  ],
  "properties": {
    "protocolVersion": {
      "type": "string",
      "default": "1.0.0"
    },
    "messageType": {
      "type": "string",
      "enum": [
        "HELLO",
        "SESSION",
        "CREATE_ROOM",
        "JOIN_ROOM",
        "ROOM_STATE",
        "PLAYER_JOINED",
        "PLAYER_LEFT",
        "READY",
        "MATCH_START",
        "ACTION",
        "LEVEL_DATA",
        "ACTION_ACCEPTED",
        "EVENT_BATCH",
        "SNAPSHOT",
        "ACK",
        "RESYNC",
        "RECONNECT",
        "MATCH_END",
        "LEAVE",
        "PING",
        "CHAT",
        "ERROR"
      ]
    },
    "requestId": {
      "type": "string"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "senderId": {
      "type": "string"
    },
    "payloadJson": {
      "type": "string"
    }
  },
  "definitions": {
    "NativeMobEntity": {
      "type": "object",
      "required": [
        "mobId",
        "entityId",
        "name",
        "pos",
        "hp",
        "ht",
        "serializedBundle",
        "buffs"
      ],
      "properties": {
        "mobId": {
          "type": "integer",
          "minimum": 0,
          "description": "Publisher-local SPD Actor.id(); never use as a cross-device identity."
        },
        "entityId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80,
          "description": "Stable server identity; empty is permitted only on the first publisher upload, and the server assigns it before persistence/ACK."
        },
        "name": {
          "type": "string"
        },
        "pos": {
          "type": "integer",
          "minimum": 0
        },
        "hp": {
          "type": "integer",
          "minimum": 0
        },
        "ht": {
          "type": "integer",
          "minimum": 1
        },
        "serializedBundle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200000
        },
        "buffs": {
          "type": "array",
          "maxItems": 256
        }
      }
    },
    "NativeLevelSnapshot": {
      "type": "object",
      "required": [
        "schemaVersion",
        "depth",
        "branch",
        "width",
        "height",
        "seed",
        "locked",
        "feeling",
        "nativeLevelMetadataBundle",
        "tiles",
        "transitions",
        "mobs",
        "heaps",
        "traps",
        "plants",
        "blobs",
        "visitedPositions",
        "mappedPositions"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "branch": {
          "const": 0
        },
        "width": {
          "type": "integer",
          "minimum": 8,
          "maximum": 100
        },
        "height": {
          "type": "integer",
          "minimum": 8,
          "maximum": 100
        },
        "seed": {
          "type": "integer"
        },
        "locked": {
          "type": "boolean"
        },
        "feeling": {
          "type": "string",
          "enum": [
            "NONE",
            "CHASM",
            "WATER",
            "GRASS",
            "DARK",
            "LARGE",
            "TRAPS",
            "SECRETS"
          ]
        },
        "nativeLevelMetadataBundle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200000
        },
        "mobs": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "$ref": "#/definitions/NativeMobEntity"
          }
        },
        "tiles": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/NativeTile"
          }
        },
        "transitions": {
          "type": "array",
          "maxItems": 128
        },
        "heaps": {
          "type": "array"
        },
        "traps": {
          "type": "array"
        },
        "plants": {
          "type": "array"
        },
        "blobs": {
          "type": "array",
          "maxItems": 128
        },
        "visitedPositions": {
          "type": "array"
        },
        "mappedPositions": {
          "type": "array"
        }
      }
    },
    "NativeAttackPayload": {
      "type": "object",
      "required": [
        "combatSchemaVersion",
        "combatDepth",
        "attackerId",
        "attackerPos",
        "attackKind",
        "targetHpBefore",
        "targetHtBefore",
        "targetEntityId",
        "targetType",
        "engineResult",
        "engineHit",
        "targetPos",
        "targetPosAfter",
        "targetHp",
        "targetHt",
        "damage",
        "engineDistance",
        "engineActionCost",
        "targetBuffs",
        "targetShieldBefore",
        "targetShieldAfter",
        "targetHeroStateJson"
      ],
      "properties": {
        "targetEntityId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 8,
          "maxLength": 80,
          "description": "Required for mob targets; resolves the authoritative room entity, not local Actor.id()."
        },
        "targetType": {
          "type": "string",
          "enum": [
            "MOB",
            "PLAYER"
          ]
        },
        "engineResult": {
          "type": "boolean"
        },
        "engineHit": {
          "type": "boolean"
        },
        "targetPos": {
          "type": "integer",
          "minimum": 0
        },
        "targetHp": {
          "type": "integer",
          "minimum": 0
        },
        "targetHt": {
          "type": "integer",
          "minimum": 1
        },
        "damage": {
          "type": "integer",
          "minimum": 0
        },
        "engineDistance": {
          "type": "number",
          "minimum": 0
        },
        "engineActionCost": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10
        },
        "combatSchemaVersion": {
          "type": "integer",
          "const": 1
        },
        "combatDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "attackerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Must match the authenticated senderId in the outer message."
        },
        "attackerPos": {
          "type": "integer",
          "minimum": 0,
          "description": "Attacker position before native attack resolution; checked against server room state."
        },
        "attackKind": {
          "type": "string",
          "enum": [
            "MELEE",
            "RANGED"
          ]
        },
        "targetHpBefore": {
          "type": "integer",
          "minimum": 0,
          "description": "Target HP observed by the native engine immediately before resolving the attack."
        },
        "targetHtBefore": {
          "type": "integer",
          "minimum": 1,
          "description": "Target max HP observed before resolving the attack; server rejects changes in this field."
        },
        "targetPosAfter": {
          "type": "integer",
          "minimum": 0,
          "description": "Target position after native attack effects such as knockback; server validates bounds and displacement."
        },
        "targetBuffs": {
          "type": "string",
          "maxLength": 200000,
          "description": "JSON array of serialized native Buff bundles and cooldowns captured after the attack."
        },
        "targetShieldBefore": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "targetShieldAfter": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "targetHeroStateJson": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200000,
          "description": "Full native post-state when the target is a player; null for mob targets. The server preserves the target's previously trusted class/equipment/talents."
        }
      },
      "description": "Client-resolved result from the original SPD Java engine. The room validates identity, depth, position, range, pre/post HP consistency and replay ordering; it does not claim to independently reproduce Java RNG or weapon/buff procs."
    },
    "NativeTile": {
      "type": "object",
      "required": [
        "pos",
        "terrain",
        "passable",
        "solid",
        "pit",
        "losBlocking",
        "flammable",
        "secret",
        "avoid",
        "water",
        "discoverable",
        "openSpace"
      ],
      "properties": {
        "pos": {
          "type": "integer",
          "minimum": 0
        },
        "terrain": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "passable": {
          "type": "boolean"
        },
        "solid": {
          "type": "boolean"
        },
        "pit": {
          "type": "boolean"
        },
        "losBlocking": {
          "type": "boolean"
        },
        "flammable": {
          "type": "boolean"
        },
        "secret": {
          "type": "boolean"
        },
        "avoid": {
          "type": "boolean"
        },
        "water": {
          "type": "boolean"
        },
        "discoverable": {
          "type": "boolean"
        },
        "openSpace": {
          "type": "boolean"
        }
      }
    },
    "NativeCombatOutcomeEvent": {
      "type": "object",
      "required": [
        "combatSchemaVersion",
        "matchId",
        "combatDepth",
        "combatSequence",
        "combatRequestId",
        "attackerId",
        "targetId",
        "targetType",
        "attackerPos",
        "targetPos",
        "targetPosAfter",
        "targetHpBefore",
        "targetHtBefore",
        "targetHp",
        "targetHt",
        "hit",
        "damage",
        "attackKind",
        "engineDistance",
        "engineActionCost",
        "targetBuffs",
        "attackerStateJson",
        "targetShieldBefore",
        "targetShieldAfter",
        "targetHeroStateJson"
      ],
      "properties": {
        "combatSchemaVersion": {
          "type": "integer",
          "const": 1
        },
        "matchId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Server-assigned Durable Object room identity."
        },
        "combatDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "combatSequence": {
          "type": "integer",
          "minimum": 1
        },
        "combatRequestId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 80,
          "description": "Echo of the unique outer requestId; the server deduplicates this key."
        },
        "attackerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "targetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Stable server entity ID for mobs, player ID for player targets."
        },
        "targetType": {
          "type": "string",
          "enum": [
            "MOB",
            "PLAYER"
          ]
        },
        "attackerPos": {
          "type": "integer",
          "minimum": 0
        },
        "targetPos": {
          "type": "integer",
          "minimum": 0,
          "description": "Target pre-state position used for authoritative range validation."
        },
        "targetPosAfter": {
          "type": "integer",
          "minimum": 0,
          "description": "Native post-state position after knockback or other movement procs."
        },
        "targetHpBefore": {
          "type": "integer",
          "minimum": 0
        },
        "targetHtBefore": {
          "type": "integer",
          "minimum": 1
        },
        "targetHp": {
          "type": "integer",
          "minimum": 0
        },
        "targetHt": {
          "type": "integer",
          "minimum": 1
        },
        "hit": {
          "type": "boolean"
        },
        "damage": {
          "type": "integer",
          "minimum": 0
        },
        "attackKind": {
          "type": "string",
          "enum": [
            "MELEE",
            "RANGED"
          ]
        },
        "engineDistance": {
          "type": "number",
          "minimum": 0
        },
        "engineActionCost": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10
        },
        "targetBuffs": {
          "type": "string",
          "maxLength": 200000
        },
        "attackerStateJson": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200000
        },
        "targetShieldBefore": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "targetShieldAfter": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "targetHeroStateJson": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200000,
          "description": "Server-sanitized target state; trusted class/equipment/talents are retained from the previous authoritative player state."
        }
      },
      "description": "Server-sequenced result from native SPD Java combat. The server validates sender/target identity, current depth and positions, legal geometry, pre/post HP, native buff bundle bounds, loot changes, action cost and request deduplication. The Worker does not reproduce SPD Java RNG or weapon/buff procs; client-resolved outcome trust remains limited to these checks."
    }
  }
}
