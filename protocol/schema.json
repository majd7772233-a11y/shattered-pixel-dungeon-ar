{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SPDMultiplayerProtocol",
  "version": "1.0.0",
  "type": "object",
  "required": [
    "protocolVersion",
    "messageType",
    "payloadJson"
  ],
  "properties": {
    "protocolVersion": {
      "type": "string",
      "default": "1.0.0"
    },
    "messageType": {
      "type": "string",
      "enum": [
        "HELLO",
        "SESSION",
        "CREATE_ROOM",
        "JOIN_ROOM",
        "ROOM_STATE",
        "PLAYER_JOINED",
        "PLAYER_LEFT",
        "READY",
        "MATCH_START",
        "ACTION",
        "LEVEL_DATA",
        "LEVEL_READY",
        "ACTION_ACCEPTED",
        "EVENT_BATCH",
        "SNAPSHOT",
        "ACK",
        "RESYNC",
        "RECONNECT",
        "MATCH_END",
        "LEAVE",
        "PING",
        "CHAT",
        "ERROR",
        "COMBAT_REQUEST"
      ]
    },
    "requestId": {
      "type": "string"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "senderId": {
      "type": "string"
    },
    "payloadJson": {
      "type": "string"
    }
  },
  "definitions": {
    "NativeMobEntity": {
      "type": "object",
      "required": [
        "mobId",
        "entityId",
        "name",
        "pos",
        "hp",
        "ht",
        "serializedBundle",
        "buffs",
        "shielding",
        "state",
        "defenseSkill",
        "baseSpeed",
        "effectiveSpeed",
        "cooldown",
        "targetCell",
        "targetType",
        "targetEntityId",
        "enemySeen",
        "alerted"
      ],
      "properties": {
        "mobId": {
          "type": "integer",
          "minimum": 0,
          "description": "Publisher-local SPD Actor.id(); never use as a cross-device identity."
        },
        "entityId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80,
          "description": "Stable server identity; empty is permitted only on the first publisher upload, and the server assigns it before persistence/ACK."
        },
        "name": {
          "type": "string"
        },
        "pos": {
          "type": "integer",
          "minimum": 0
        },
        "hp": {
          "type": "integer",
          "minimum": 0
        },
        "ht": {
          "type": "integer",
          "minimum": 1
        },
        "serializedBundle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200000
        },
        "buffs": {
          "type": "array",
          "maxItems": 256
        },
        "shielding": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000,
          "description": "Native derived shield total captured with mob HP/HT and buff pre-state."
        },
        "state": {
          "type": "string",
          "maxLength": 80,
          "description": "Native SPD AI state after this full snapshot."
        },
        "defenseSkill": {
          "type": "integer",
          "description": "Native SPD defense skill captured from the Mob."
        },
        "baseSpeed": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "effectiveSpeed": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000,
          "description": "Native effective speed after active modifiers."
        },
        "cooldown": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000,
          "description": "Remaining native Actor cooldown."
        },
        "targetCell": {
          "type": "integer",
          "minimum": -1,
          "description": "Native AI target cell; -1 when absent."
        },
        "targetType": {
          "type": "string",
          "enum": [
            "NONE",
            "MOB",
            "PLAYER"
          ]
        },
        "targetEntityId": {
          "type": "string",
          "maxLength": 128,
          "description": "Stable target ID; empty only when targetType is NONE."
        },
        "enemySeen": {
          "type": "boolean"
        },
        "alerted": {
          "type": "boolean"
        }
      }
    },
    "NativeLevelSnapshot": {
      "type": "object",
      "required": [
        "schemaVersion",
        "depth",
        "branch",
        "width",
        "height",
        "seed",
        "locked",
        "feeling",
        "nativeLevelMetadataBundle",
        "tiles",
        "transitions",
        "mobs",
        "heaps",
        "traps",
        "plants",
        "blobs",
        "visitedPositions",
        "mappedPositions"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "branch": {
          "const": 0
        },
        "width": {
          "type": "integer",
          "minimum": 8,
          "maximum": 100
        },
        "height": {
          "type": "integer",
          "minimum": 8,
          "maximum": 100
        },
        "seed": {
          "type": "integer"
        },
        "locked": {
          "type": "boolean"
        },
        "feeling": {
          "type": "string",
          "enum": [
            "NONE",
            "CHASM",
            "WATER",
            "GRASS",
            "DARK",
            "LARGE",
            "TRAPS",
            "SECRETS"
          ]
        },
        "nativeLevelMetadataBundle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200000
        },
        "nativeWorldMutation": {
          "type": "boolean"
        },
        "nativeMutationAction": {
          "type": "string",
          "enum": ["MOVE", "UNLOCK", "MINE", "INTERACT", "OPEN_CHEST", "PICKUP", "DROP", "EQUIP", "UNEQUIP", "BUY"]
        },
        "nativeMutationRequestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "nativeMutationFrom": {
          "type": "integer",
          "minimum": 0
        },
        "nativeMutationTargetPos": {
          "type": "integer",
          "minimum": 0
        },
        "mobs": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "$ref": "#/definitions/NativeMobEntity"
          }
        },
        "tiles": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/NativeTile"
          }
        },
        "transitions": {
          "type": "array",
          "maxItems": 128
        },
        "heaps": {
          "type": "array",
          "maxItems": 640,
          "items": {
            "$ref": "#/definitions/NativeHeap"
          }
        },
        "traps": {
          "type": "array"
        },
        "plants": {
          "type": "array"
        },
        "blobs": {
          "type": "array",
          "maxItems": 128
        },
        "visitedPositions": {
          "type": "array"
        },
        "mappedPositions": {
          "type": "array"
        },
        "nativeMutationDetails": {
          "type": "object",
          "additionalProperties": false,
          "description": "Stable identity for a native item/heap mutation; present only on the action-bound post-state snapshot.",
          "properties": {
            "heapId": {"type":"string","minLength":8,"maxLength":80},
            "itemId": {"type":"string","minLength":8,"maxLength":80},
            "itemClass": {"type":"string","minLength":1,"maxLength":256},
            "expectedQuantity": {"type":"integer","minimum":1,"maximum":100000},
            "stackable": {"type":"boolean"},
            "resultItemId": {"type":"string","minLength":8,"maxLength":80},
            "sourceQuantityBefore": {"type":"integer","minimum":1,"maximum":100000},
            "itemLevel": {"type":"integer","minimum":-100,"maximum":10000},
            "cursed": {"type":"boolean"},
            "cursedKnown": {"type":"boolean"},
            "price": {"type":"integer","minimum":0,"maximum":10000000},
            "acquiredByInventory": {"type":"boolean"},
            "resultHeapId": {"type":"string","minLength":0,"maxLength":80},
            "expectedEquipped": {"type":"boolean"},
            "heapType": {"type":"string","enum":["CHEST","LOCKED_CHEST","CRYSTAL_CHEST"]}
          }
        }
      }
    },
    "NativeAttackPayload": {
      "type": "object",
      "required": [
        "combatSchemaVersion",
        "combatDepth",
        "attackerId",
        "attackerPos",
        "attackKind",
        "targetHpBefore",
        "targetHtBefore",
        "targetEntityId",
        "targetType",
        "engineResult",
        "engineHit",
        "targetPos",
        "targetPosAfter",
        "targetHp",
        "targetHt",
        "damage",
        "engineDistance",
        "engineActionCost",
        "targetBuffs",
        "targetShieldBefore",
        "targetShieldAfter",
        "targetHeroStateJson",
        "targetBuffsBefore",
        "secondaryMobDeltas",
        "attackerStateBefore",
        "targetHeroStateBefore",
        "attackWeaponMode",
        "attackWeaponBundle",
        "damageMultiplier",
        "damageBonus",
        "accuracyMultiplier"
      ],
      "properties": {
        "targetEntityId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 8,
          "maxLength": 80,
          "description": "Required for mob targets; resolves the authoritative room entity, not local Actor.id()."
        },
        "targetType": {
          "type": "string",
          "enum": [
            "MOB",
            "PLAYER"
          ]
        },
        "engineResult": {
          "type": "boolean"
        },
        "engineHit": {
          "type": "boolean"
        },
        "targetPos": {
          "type": "integer",
          "minimum": 0
        },
        "targetHp": {
          "type": "integer",
          "minimum": 0
        },
        "targetHt": {
          "type": "integer",
          "minimum": 1
        },
        "damage": {
          "type": "integer",
          "minimum": 0
        },
        "engineDistance": {
          "type": "number",
          "minimum": 0
        },
        "engineActionCost": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10
        },
        "combatSchemaVersion": {
          "type": "integer",
          "const": 1
        },
        "combatDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "attackerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Must match the authenticated senderId in the outer message."
        },
        "attackerPos": {
          "type": "integer",
          "minimum": 0,
          "description": "Attacker position before native attack resolution; checked against server room state."
        },
        "attackKind": {
          "type": "string",
          "enum": [
            "MELEE",
            "RANGED"
          ]
        },
        "targetHpBefore": {
          "type": "integer",
          "minimum": 0,
          "description": "Target HP observed by the native engine immediately before resolving the attack."
        },
        "targetHtBefore": {
          "type": "integer",
          "minimum": 1,
          "description": "Target max HP observed before resolving the attack; server rejects changes in this field."
        },
        "targetPosAfter": {
          "type": "integer",
          "minimum": 0,
          "description": "Target position after native attack effects such as knockback; server validates bounds and displacement."
        },
        "targetBuffs": {
          "type": "string",
          "maxLength": 200000,
          "description": "JSON array of serialized native Buff bundles and cooldowns captured after the attack."
        },
        "targetShieldBefore": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "targetShieldAfter": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "targetHeroStateJson": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200000,
          "description": "Full native post-state when the target is a player; null for mob targets. The server preserves the target's previously trusted class/equipment/talents."
        },
        "targetBuffsBefore": {
          "type": "string",
          "maxLength": 100000,
          "description": "JSON-encoded native target buff bundles captured immediately before the attack; the server compares it to its authoritative saved target snapshot."
        },
        "secondaryMobDeltas": {
          "type": "string",
          "maxLength": 200000,
          "description": "JSON-encoded object with an explicit boolean complete flag, a deltas array, and optional heaps snapshot for secondary deaths. Every delta has a stable entityId, explicit pre/post HP/HT/position/shield/buffs fields (including numeric zero values), and serializedBundleAfter. Incomplete or missing fields require authoritative resync; never infer omitted zero-valued fields."
        },
        "attackerStateBefore": {
          "type": "string",
          "maxLength": 200000,
          "description": "Native attacker state captured immediately before the attack; validated against server-held hero state before an authority client resolves combat."
        },
        "targetHeroStateBefore": {
          "type": "string",
          "maxLength": 200000,
          "description": "Trusted defender native hero state captured before attack."
        },
        "targetMobBundleAfter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200000,
          "description": "Complete native Mob bundle captured after combat on the designated authority; required for living mob targets."
        },
        "attackWeaponMode": {
          "type": "string",
          "enum": [
            "EQUIPPED",
            "THROWN",
            "ABILITY",
            "UNARMED"
          ],
          "description": "Original SPD attacking-weapon context captured at the attack site."
        },
        "attackWeaponBundle": {
          "type": "string",
          "maxLength": 200000,
          "description": "Serialized native item Bundle matched against the trusted restored attacker inventory for THROWN/ABILITY modes."
        },
        "damageMultiplier": {
          "type": "number",
          "minimum": 0,
          "maximum": 10,
          "description": "Original native Hero.attack damage multiplier argument."
        },
        "damageBonus": {
          "type": "number",
          "minimum": -10000,
          "maximum": 100000,
          "description": "Original native Hero.attack flat damage bonus argument."
        },
        "accuracyMultiplier": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Original native Hero.attack accuracy multiplier argument."
        }
      },
      "description": "Versioned native SPD combat result. Non-publisher mob attacks and all PvP attacks are resolved by the server-designated level publisher or target-player owner by executing the original Java combat pipeline; the Worker validates pending request identity, pre-state, geometry, result transitions, and replay protection. Only the authenticated level publisher may commit shared mob state and loot. The Worker does not independently reproduce SPD Java RNG.",
      "allOf": [
        {
          "if": {
            "properties": {
              "targetType": {
                "const": "MOB"
              }
            },
            "required": [
              "targetType"
            ]
          },
          "then": {
            "properties": {
              "targetEntityId": {
                "type": "string",
                "minLength": 8,
                "maxLength": 80
              },
              "targetHeroStateJson": {
                "type": "null"
              }
            },
            "required": [
              "targetEntityId",
              "targetHeroStateJson",
              "targetMobBundleAfter"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "targetType": {
                "const": "PLAYER"
              }
            },
            "required": [
              "targetType"
            ]
          },
          "then": {
            "properties": {
              "targetEntityId": {
                "type": "null"
              },
              "targetHeroStateJson": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200000
              }
            },
            "required": [
              "targetEntityId",
              "targetHeroStateJson"
            ]
          }
        }
      ]
    },
    "NativeTile": {
      "type": "object",
      "required": [
        "pos",
        "terrain",
        "passable",
        "solid",
        "pit",
        "losBlocking",
        "flammable",
        "secret",
        "avoid",
        "water",
        "discoverable",
        "openSpace"
      ],
      "properties": {
        "pos": {
          "type": "integer",
          "minimum": 0
        },
        "terrain": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "passable": {
          "type": "boolean"
        },
        "solid": {
          "type": "boolean"
        },
        "pit": {
          "type": "boolean"
        },
        "losBlocking": {
          "type": "boolean"
        },
        "flammable": {
          "type": "boolean"
        },
        "secret": {
          "type": "boolean"
        },
        "avoid": {
          "type": "boolean"
        },
        "water": {
          "type": "boolean"
        },
        "discoverable": {
          "type": "boolean"
        },
        "openSpace": {
          "type": "boolean"
        }
      }
    },
    "NativeCombatOutcomeEvent": {
      "type": "object",
      "required": [
        "combatSchemaVersion",
        "matchId",
        "combatDepth",
        "combatSequence",
        "combatRequestId",
        "attackerId",
        "targetId",
        "targetType",
        "attackerPos",
        "targetPos",
        "targetPosAfter",
        "targetHpBefore",
        "targetHtBefore",
        "targetHp",
        "targetHt",
        "hit",
        "damage",
        "attackKind",
        "engineDistance",
        "engineActionCost",
        "targetBuffs",
        "attackerStateJson",
        "targetShieldBefore",
        "targetShieldAfter",
        "targetHeroStateJson",
        "attackerType",
        "sourceType",
        "sourceEntityId",
        "sourcePos",
        "sourceAttackKind",
        "targetBuffsBefore"
      ],
      "properties": {
        "combatSchemaVersion": {
          "type": "integer",
          "const": 1
        },
        "matchId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Server-assigned Durable Object room identity."
        },
        "combatDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "combatSequence": {
          "type": "integer",
          "minimum": 1
        },
        "combatRequestId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 80,
          "description": "Echo of the unique outer requestId; the server deduplicates this key."
        },
        "attackerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "targetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Stable server entity ID for mobs, player ID for player targets."
        },
        "targetType": {
          "type": "string",
          "enum": [
            "MOB",
            "PLAYER"
          ]
        },
        "attackerPos": {
          "type": "integer",
          "minimum": 0
        },
        "targetPos": {
          "type": "integer",
          "minimum": 0,
          "description": "Target pre-state position used for authoritative range validation."
        },
        "targetPosAfter": {
          "type": "integer",
          "minimum": 0,
          "description": "Native post-state position after knockback or other movement procs."
        },
        "targetHpBefore": {
          "type": "integer",
          "minimum": 0
        },
        "targetHtBefore": {
          "type": "integer",
          "minimum": 1
        },
        "targetHp": {
          "type": "integer",
          "minimum": 0
        },
        "targetHt": {
          "type": "integer",
          "minimum": 1
        },
        "hit": {
          "type": "boolean"
        },
        "damage": {
          "type": "integer",
          "minimum": 0
        },
        "attackKind": {
          "type": "string",
          "enum": [
            "MELEE",
            "RANGED"
          ]
        },
        "engineDistance": {
          "type": "number",
          "minimum": 0
        },
        "engineActionCost": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10
        },
        "targetBuffs": {
          "type": "string",
          "maxLength": 200000
        },
        "attackerStateJson": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200000,
          "description": "Native player state for player attackers; null for mob attackers."
        },
        "targetShieldBefore": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "targetShieldAfter": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "targetHeroStateJson": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200000,
          "description": "Server-sanitized target state for player targets; null for mob targets. Trusted class/equipment/talents are retained from the prior authoritative player state."
        },
        "attackerType": {
          "type": "string",
          "enum": [
            "PLAYER",
            "MOB"
          ]
        },
        "sourceType": {
          "type": "string",
          "enum": [
            "PLAYER",
            "MOB"
          ]
        },
        "sourceEntityId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "sourcePos": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "sourceAttackKind": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "MELEE",
            "RANGED",
            null
          ]
        },
        "sourceMobHpBefore": {
          "type": "integer",
          "minimum": 0
        },
        "sourceMobHtBefore": {
          "type": "integer",
          "minimum": 1
        },
        "sourceMobPosBefore": {
          "type": "integer",
          "minimum": 0
        },
        "sourceMobHpAfter": {
          "type": "integer",
          "minimum": 0
        },
        "sourceMobHtAfter": {
          "type": "integer",
          "minimum": 1
        },
        "sourceMobPosAfter": {
          "type": "integer",
          "minimum": 0
        },
        "sourceMobDamage": {
          "type": "integer",
          "minimum": 0
        },
        "sourceMobBuffsBefore": {
          "type": "string",
          "maxLength": 200000
        },
        "sourceMobBuffs": {
          "type": "string",
          "maxLength": 200000
        },
        "heaps": {
          "type": "array",
          "maxItems": 1024,
          "description": "Full native heap snapshot, included only when an accepted combat effect kills a mob."
        },
        "sourceMobShieldBefore": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000,
          "description": "Native mob shield total before retaliation/thorns effects."
        },
        "sourceMobShieldAfter": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000,
          "description": "Native mob shield total after retaliation/thorns effects."
        },
        "targetBuffsBefore": {
          "type": "string",
          "maxLength": 100000,
          "description": "Native target buff bundles immediately before the validated combat action."
        },
        "targetMobBundleAfter": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200000,
          "description": "Authoritative native Mob bundle after a player attack; peers request a full snapshot to restore this state exactly."
        },
        "sourceMobBundleAfter": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200000,
          "description": "Full native source mob bundle after defensive procs when a mob damages a player."
        }
      },
      "description": "Server-sequenced result from native SPD Java combat. The server validates sender/target identity, current depth and positions, legal geometry, pre/post HP, native buff bundle bounds, loot changes, action cost and request deduplication. The Worker does not reproduce SPD Java RNG or weapon/buff procs; client-resolved outcome trust remains limited to these checks.",
      "allOf": [
        {
          "if": {
            "properties": {
              "targetType": {
                "const": "MOB"
              }
            },
            "required": [
              "targetType"
            ]
          },
          "then": {
            "properties": {
              "targetHeroStateJson": {
                "type": "null"
              }
            },
            "required": [
              "targetHeroStateJson"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "targetType": {
                "const": "PLAYER"
              }
            },
            "required": [
              "targetType"
            ]
          },
          "then": {
            "properties": {
              "targetHeroStateJson": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200000
              }
            },
            "required": [
