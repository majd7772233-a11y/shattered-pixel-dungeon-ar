{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SPDMultiplayerProtocol",
  "version": "1.0.0",
  "type": "object",
  "required": ["protocolVersion", "messageType", "payloadJson"],
  "properties": {
    "protocolVersion": {
      "type": "string",
      "default": "1.0.0"
    },
    "messageType": {
      "type": "string",
      "enum": [
        "HELLO",
        "SESSION",
        "CREATE_ROOM",
        "JOIN_ROOM",
        "ROOM_STATE",
        "PLAYER_JOINED",
        "PLAYER_LEFT",
        "READY",
        "MATCH_START",
        "ACTION",
        "ACTION_ACCEPTED",
        "EVENT_BATCH",
        "SNAPSHOT",
        "ACK",
        "RESYNC",
        "RECONNECT",
        "MATCH_END",
        "LEAVE",
        "PING",
        "CHAT",
        "ERROR"
      ]
    },
    "requestId": {
      "type": "string"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "senderId": {
      "type": "string"
    },
    "payloadJson": {
      "type": "string"
    }
  }
}
